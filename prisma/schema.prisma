// Sportstech Creative Ops — data model.
// Mirrors the original single-file app's shape (project / event / comment) so
// the domain logic in lib/domain.ts ports over almost unchanged.
//
// NOTE: roster, roles, stages and the move graph are intentionally NOT tables.
// They're a fixed config in lib/domain.ts, same as the original file — nobody
// can grant themselves a role or invent a stage, because there's no row to
// insert. If that ever needs to change (e.g. an admin UI for the roster),
// promote ROSTER to a real table then.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          String   @id @default(uuid())
  product     String
  asin        String   @default("")
  dtype       String
  market      String   @default("DE")

  designer    String?
  lead        String?
  head        String?
  pm          String?

  stage       String   @default("product")
  priority    String   @default("med")

  dueDate     DateTime? @map("due_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  stageSince  DateTime  @default(now()) @map("stage_since")

  ticketId    String   @default("") @map("ticket_id")
  ticketUrl   String   @default("") @map("ticket_url")
  briefUrl    String   @default("") @map("brief_url")
  workUrl     String   @default("") @map("work_url")

  blocked     Boolean  @default(false)
  blockReason String   @default("") @map("block_reason")

  revLead     Int      @default(0) @map("rev_lead")
  revHead     Int      @default(0) @map("rev_head")
  revAmz      Int      @default(0) @map("rev_amz")

  events      Event[]
  comments    Comment[]

  @@map("projects")
}

model Event {
  id         String    @id @default(uuid())
  projectId  String    @map("project_id")
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  at         DateTime  @default(now())
  actor      String
  actorRole  String    @map("actor_role")
  kind       String    // create | stage | comment | block | unblock | edit
  fromStage  String?   @map("from_stage")
  toStage    String?   @map("to_stage")
  note       String?

  @@index([projectId, at])
  @@map("events")
}

model Comment {
  id         String    @id @default(uuid())
  projectId  String    @map("project_id")
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  at         DateTime  @default(now())
  actor      String
  actorRole  String    @map("actor_role")
  text       String

  @@index([projectId, at])
  @@map("comments")
}
