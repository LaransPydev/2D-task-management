generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          String    @id @default(uuid())
  product     String
  asin        String    @default("")
  dtype       String
  market      String    @default("DE")
  designer    String?
  lead        String?
  head        String?
  pm          String?
  stage       String    @default("product")
  priority    String    @default("med")
  dueDate     DateTime? @map("due_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  stageSince  DateTime  @default(now()) @map("stage_since")
  ticketId    String    @default("") @map("ticket_id")
  ticketType  String    @default("") @map("ticket_type")
  ticketUrl   String    @default("") @map("ticket_url")
  briefUrl    String    @default("") @map("brief_url")
  workUrl     String    @default("") @map("work_url")
  blocked     Boolean   @default(false)
  blockReason String    @default("") @map("block_reason")
  revLead     Int       @default(0) @map("rev_lead")
  revHead     Int       @default(0) @map("rev_head")
  revAmz      Int       @default(0) @map("rev_amz")
  comments    Comment[]
  events      Event[]

  @@map("projects")
}

model Event {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  at        DateTime @default(now())
  actor     String
  actorRole String   @map("actor_role")
  kind      String
  fromStage String?  @map("from_stage")
  toStage   String?  @map("to_stage")
  note      String?
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, at])
  @@map("events")
}

model Comment {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  at        DateTime @default(now())
  actor     String
  actorRole String   @map("actor_role")
  text      String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, at])
  @@map("comments")
}

model Member {
  id                String    @id @default(uuid())
  name              String    @unique
  username          String    @unique
  email             String?   @unique
  role              String    @default("designer")
  passwordHash      String?   @map("password_hash")
  passwordUpdatedAt DateTime? @map("password_updated_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String    @map("created_by")

  @@map("members")
}

model DeliverableType {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by")

  @@map("deliverable_types")
}

model Market {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by")

  @@map("markets")
}
