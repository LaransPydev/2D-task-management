# Copy this file to .env (local dev) and fill in real values.
# In Vercel, set these under Project Settings -> Environment Variables instead
# of committing a .env file.

# Postgres connection string.
#   Local dev:  run `npx prisma dev` and paste the URL it prints.
#   Production: Vercel Postgres connection string (Storage tab -> .env.local snippet).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Random secret used to sign the sign-in cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it stable across restarts/deploys, or every signed-in session is invalidated.
AUTH_SECRET="replace-with-a-random-64-char-hex-string"
